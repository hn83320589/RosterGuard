<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RosterGuard.App.ViewModels"
             xmlns:core="using:RosterGuard.Core.Domain"
             x:Class="RosterGuard.App.Views.RosterView"
             x:DataType="vm:RosterViewModel">

  <UserControl.Styles>
    <Style Selector="Button.cell, Button.coverage">
      <Setter Property="Width" Value="72" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderBrush" Value="#DDDDDD" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.coverage">
      <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="Button.cell.highlight, Button.coverage.highlight">
      <Setter Property="BorderBrush" Value="#1565C0" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="Border.rowHeader">
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="BorderBrush" Value="#DDDDDD" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>
    <Style Selector="Border.coverageHeader">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Background" Value="#FAFAFA" />
      <Setter Property="BorderBrush" Value="#DDDDDD" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,380">
    <DockPanel Grid.Column="0">
      <!-- 工具列 -->
      <WrapPanel DockPanel.Dock="Top" Margin="8" Orientation="Horizontal">
        <Button Name="PreviousMonthButton" Content="◀" Command="{Binding PreviousMonthCommand}" ToolTip.Tip="上個月" />
        <TextBlock Name="MonthTitleText" Text="{Binding MonthTitle}" FontSize="20" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="12,0" MinWidth="140" TextAlignment="Center" />
        <Button Name="NextMonthButton" Content="▶" Command="{Binding NextMonthCommand}" ToolTip.Tip="下個月" />
        <Separator Width="16" Background="Transparent" />
        <Button Name="UndoButton" Content="{Binding UndoText}" Command="{Binding UndoCommand}" ToolTip.Tip="Ctrl+Z" />
        <Button Name="RedoButton" Content="{Binding RedoText}" Command="{Binding RedoCommand}" Margin="4,0,0,0" ToolTip.Tip="Ctrl+Y" />
        <Separator Width="16" Background="Transparent" />
        <TextBlock Text="複製週：" VerticalAlignment="Center" />
        <ComboBox Name="CopySourceBox" ItemsSource="{Binding Weeks}" SelectedItem="{Binding CopySource}" MinWidth="130">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:WeekOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text=" → " VerticalAlignment="Center" />
        <ComboBox Name="CopyTargetBox" ItemsSource="{Binding Weeks}" SelectedItem="{Binding CopyTarget}" MinWidth="130">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:WeekOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Name="CopyWeekButton" Content="複製上週" Command="{Binding CopyWeekCommand}" Margin="4,0,0,0"
                ToolTip.Tip="清空目標週（本月範圍內）後，複製來源週的指派；略過已停用的員工與班別" />
        <Separator Width="16" Background="Transparent" />
        <Button Name="ExportCsvButton" Content="匯出月班表 CSV" Click="ExportCsv_Click" />
        <ComboBox Name="IcsEmployeeBox" ItemsSource="{Binding ExportEmployees}" Margin="8,0,0,0" MinWidth="100"
                  PlaceholderText="選擇員工">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="core:Employee">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Name="ExportIcsButton" Content="匯出個人 ICS" Click="ExportIcs_Click" Margin="4,0,0,0" />
      </WrapPanel>

      <!-- 圖例 -->
      <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Legend}" Margin="8,0,8,6">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LegendItem">
            <Border Background="{Binding Background}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Badge}" Foreground="{Binding Accent}" FontWeight="Bold" />
                <TextBlock Text="{Binding Name}" FontSize="12" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 格網：外層垂直捲動；左欄員工名稱固定，右側日期水平捲動 -->
      <ScrollViewer Name="VerticalScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid ColumnDefinitions="150,*">
          <StackPanel Grid.Column="0">
            <Border Height="44" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,1,1" Padding="8,4">
              <TextBlock Text="員工 ＼ 日期" VerticalAlignment="Center" FontWeight="SemiBold" />
            </Border>
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EmployeeRowViewModel">
                  <Border Classes="rowHeader">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding SubTitle}" FontSize="11" Foreground="Gray" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="28" Background="#ECEFF1" Padding="8,4">
              <TextBlock Text="人力（已排/需求）" FontWeight="SemiBold" FontSize="12" />
            </Border>
            <ItemsControl ItemsSource="{Binding CoverageRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CoverageRowViewModel">
                  <Border Classes="coverageHeader">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                      <TextBlock Text="{Binding SubTitle}" FontSize="11" Foreground="Gray" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <ScrollViewer Name="HorizontalScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DayHeaderViewModel">
                    <Border Width="72" Height="44" Background="{Binding Background}" BorderBrush="#DDDDDD" BorderThickness="0,0,1,1">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DayText}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding WeekdayText}" HorizontalAlignment="Center" FontSize="11" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl Name="RowsControl" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EmployeeRowViewModel">
                    <ItemsControl ItemsSource="{Binding Cells}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CellViewModel">
                          <Button Classes="cell" Classes.highlight="{Binding IsHighlighted}"
                                  Background="{Binding Background}" ToolTip.Tip="{Binding ToolTip}">
                            <Button.Flyout>
                              <Flyout Placement="Bottom">
                                <StackPanel Spacing="4" MinWidth="200">
                                  <TextBlock Text="指派班別（可複選）" FontWeight="SemiBold" />
                                  <ItemsControl ItemsSource="{Binding Options}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="vm:ShiftOptionViewModel">
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </Flyout>
                            </Button.Flyout>
                            <Grid>
                              <TextBlock Text="{Binding ShiftText}" FontSize="12" TextAlignment="Center"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                              <ItemsControl ItemsSource="{Binding Badges}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:BadgeViewModel">
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Accent}" FontSize="10" FontWeight="Bold" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="28" Background="#ECEFF1" />

              <ItemsControl ItemsSource="{Binding CoverageRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CoverageRowViewModel">
                    <ItemsControl ItemsSource="{Binding Cells}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CoverageCellViewModel">
                          <Button Classes="coverage" Classes.highlight="{Binding IsHighlighted}"
                                  Background="{Binding Background}" ToolTip.Tip="{Binding ToolTip}"
                                  Command="{Binding SelectCommand}" CommandParameter="{Binding}">
                            <TextBlock Text="{Binding Text}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </ScrollViewer>
    </DockPanel>

    <!-- 右側：違規面板 + 候選人建議 -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" Background="#FAFAFA">
      <TextBlock Grid.Row="0" Margin="10,8" FontWeight="SemiBold" FontSize="16" Text="{Binding ViolationSummary}" />
      <ListBox Grid.Row="1" Name="ViolationList" ItemsSource="{Binding Violations}" SelectedItem="{Binding SelectedViolation}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ViolationItemViewModel">
            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
              <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="{Binding Accent}" VerticalAlignment="Top">
                <TextBlock Text="{Binding Badge}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding SeverityText}" Foreground="{Binding SeverityBrush}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding RuleText}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Who}" />
                  <TextBlock Text="{Binding DateText}" Foreground="Gray" />
                </StackPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Foreground="#444444" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,8">
        <StackPanel Spacing="2">
          <TextBlock Text="候選人建議" FontWeight="SemiBold" FontSize="16" />
          <TextBlock Name="CandidateTitleText" Text="{Binding CandidateTitle}" Foreground="Gray" TextWrapping="Wrap" />
          <TextBlock Name="CandidateMessageText" Text="{Binding CandidateMessage}" Foreground="#C62828" TextWrapping="Wrap"
                     IsVisible="{Binding CandidateMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>
      <ScrollViewer Grid.Row="3" MaxHeight="240" Padding="10,0,10,8">
        <ItemsControl Name="CandidateList" ItemsSource="{Binding Candidates}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CandidateItemViewModel">
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding HoursText}" Foreground="Gray" VerticalAlignment="Center" Margin="8,0" />
                <Button Grid.Column="2" Content="指派" Command="{Binding AssignCommand}" CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
